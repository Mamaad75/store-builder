generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreStatus {
  DRAFT // never published
  PUBLISHED // live, publishedVersionId set
  UNPUBLISHED // was published, taken offline
}

enum PageType {
  HOME
  PRODUCTS
  PRODUCT_DETAIL
  ABOUT
  CONTACT
}

enum ProductStatus {
  DRAFT // not published
  ACTIVE // eligible to appear on the published storefront
  ARCHIVED // removed from the active catalog
}

enum MediaStatus {
  PENDING // row reserved (quota counted), object may or may not exist yet
  READY // object stored and usable
  DELETING // being removed; never referenced again, physical delete in progress/retried
}

/// Staff roles of a store (D23-1). The OWNER is not a role row: it is Store.ownerId (exactly one per store).
enum StoreRole {
  MANAGER // everything except deleting the store and managing staff
  OPERATOR // catalog, media and pages only
}

enum DomainKind {
  SUBDOMAIN
  CUSTOM
}

model User {
  id           String              @id @default(cuid())
  /// Sign-in name (ADR 0001, U1): lower-case a-z, 0-9 and "_", starts with a letter, 3-30 characters (also a database CHECK).
  username     String              @unique
  /// DEPRECATED (U1): no longer collected or used. Kept only until the approved contract migration drops it.
  email        String?             @unique
  name         String
  passwordHash String
  authVersion  Int                 @default(0)
  /// MVP item 2: when platform support last recovered this account (the owner sees a notice on the dashboard).
  recoveredAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  stores       Store[]
  media        Media[]
  resetToken   PasswordResetToken?
  memberships  StoreMember[]
  invitations  StoreInvitation[]   @relation("invitee")
  platformRole PlatformAdmin?      @relation("platformRole")
  usedInvite   RegistrationInvite? @relation("inviteUser")
  recoveries   AccountRecovery[]
}

/// MVP item 2: a single-use invitation to register while registration is invite-only. Only the SHA-256 of the code is stored.
model RegistrationInvite {
  id           String    @id @default(cuid())
  codeHash     String    @unique @db.Char(64)
  note         String    @default("") @db.VarChar(100)
  /// The super admin who issued it; null = the server command.
  createdById  String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?   @unique
  revokedAt    DateTime?

  usedBy User? @relation("inviteUser", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// MVP item 2 (roadmap §12.3): a single-use, short-lived link to set a new password, issued by a super admin after verifying the user's
/// identity outside the application. Only the SHA-256 of the token is stored. At most one usable link per user (partial unique index).
model AccountRecovery {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique @db.Char(64)
  reason      String    @db.VarChar(500)
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// DEPRECATED (U1, ADR 0001): password reset by e-mail was removed with the e-mail address; nothing reads or writes this table.
/// Kept only until the approved contract migration drops it.
/// Password-reset token: AT MOST ONE row per user (unique userId), so concurrent reset requests cannot leave two live links.
/// Only the SHA-256 of the token is stored (the raw value exists only in the emailed link).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Template {
  id        String            @id @default(cuid())
  key       String            @unique
  name      String
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  versions  TemplateVersion[]
}

model TemplateVersion {
  id              String   @id @default(cuid())
  templateId      String
  version         Int
  defaultSettings Json
  defaultPages    Json
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  template        Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  stores          Store[]

  @@unique([templateId, version])
}

model Store {
  id                 String      @id @default(cuid())
  ownerId            String
  templateVersionId  String
  name               String
  status             StoreStatus @default(DRAFT)
  settings           Json
  draftRevision      Int         @default(1)
  publishedVersionId String?
  publishedAt        DateTime?
  logoId             String?
  // What the merchant sells (a label; validated against the application's category registry, NOT a DB allowlist).
  // Independent of the visual theme (templateVersionId); the renderer never reads it.
  businessCategory   String      @default("general")
  /// ADR 0003 (G2): platform administrative suspension, independent of the merchant's `status`. NULL = not suspended. Set and cleared only
  /// by platform admins, in the same transaction as the open/closed StoreSuspension row. Never written by publishing or billing.
  suspendedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  owner            User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  templateVersion  TemplateVersion        @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  logo             Media?                 @relation("StoreLogo", fields: [id, logoId], references: [storeId, id], onDelete: NoAction)
  publishedVersion StoreVersion?          @relation("PublishedVersion", fields: [id, publishedVersionId], references: [storeId, id], onDelete: Restrict)
  versions         StoreVersion[]         @relation("AllVersions")
  pages            Page[]
  categories       ProductCategory[]
  products         Product[]
  media            Media[]
  domains          Domain[]
  members          StoreMember[]
  secrets          StoreSecret[]
  tickets          SupportTicket[]
  posts            BlogPost[]
  subscription     StoreSubscription?
  platformPayments PlatformPayment[]
  purchases        SubscriptionPurchase[]
  wallet           StoreWallet?
  referralCode     StoreReferralCode?
  referralsMade    Referral[]             @relation("Referrer")
  referredBy       Referral?              @relation("Referred")
  invitations      StoreInvitation[]
  publishedSlugs   PublishedSlug[]
  customers        Customer[]
  otpChallenges    OtpChallenge[]
  shippingMethods  ShippingMethod[]
  carts            Cart[]
  orders           Order[]
  payments         Payment[]
  bankCards        StoreBankCard[]
  dailyStats       StoreDailyStat[]
  dailyVisitors    StoreDailyVisitor[]
  smsSetting       StoreSmsSetting?
  discounts        Discount[]
  redemptions      DiscountRedemption[]
  smsMessages      SmsMessage[]
  receipts         TransferReceipt[]
  counter          StoreCounter?

  @@index([ownerId, createdAt])
  @@index([status])
}

/// Immutable (a database trigger refuses every UPDATE and every direct DELETE). `contentHash` and `snapshotBytes` describe
/// the canonical UTF-8 JSON text the snapshot was written from; JSONB stores a normalised binary form of it.
model StoreVersion {
  id            String   @id @default(cuid())
  storeId       String
  number        Int
  draftRevision Int
  snapshot      Json
  contentHash   String   @default("")
  snapshotBytes Int      @default(0)
  createdAt     DateTime @default(now())

  store    Store                 @relation("AllVersions", fields: [storeId], references: [id], onDelete: Cascade)
  liveOf   Store[]               @relation("PublishedVersion")
  products StoreVersionProduct[]

  @@unique([storeId, number])
  @@unique([storeId, id])
}

model Page {
  id             String   @id @default(cuid())
  storeId        String
  type           PageType
  title          String
  slug           String
  sections       Json
  isVisible      Boolean  @default(true)
  position       Int      @default(0)
  // Optimistic-concurrency token for the editor: bumped on every change of this page, compared with what the form was loaded with.
  revision       Int      @default(1)
  // Invalid/unknown section entries moved out of `sections` by the explicit recovery action (never deleted).
  legacySections Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, type])
  @@unique([storeId, slug])
}

model ProductCategory {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  slug      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@unique([storeId, name])
  @@unique([storeId, id])
}

model Product {
  id            String        @id @default(cuid())
  storeId       String
  categoryId    String?
  imageId       String?
  name          String
  slug          String
  description   String        @default("")
  price         Int
  stockQuantity Int           @default(0)
  /// Phase 3.3: shipping weight in grams (0..1,000,000; CHECK), null = unknown.
  weightGrams   Int?
  searchKey     String        @default("")
  // Ordered [{label, value}] text rows owned by the product (independent of theme and business category).
  // Empty by default; the database only guarantees "an array of at most 30 elements" (see the phase9c migration):
  // element-level validity is checked by the application and invalid stored values are preserved, never replaced.
  specs         Json          @default("[]")
  status        ProductStatus @default(DRAFT)
  position      Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     ProductCategory?   @relation(fields: [storeId, categoryId], references: [storeId, id], onDelete: Restrict)
  image        Media?             @relation(fields: [storeId, imageId], references: [storeId, id], onDelete: NoAction)
  variants     ProductVariant[]
  reservations StockReservation[]
  priceLinks   PriceLink[]
  livePrices   LivePrice[]
  cartItems    CartItem[]
  /// The extra images of the gallery (positions 1 to 5); the first image stays `image` (imageId).
  gallery      ProductImage[]
  reviews      ProductReview[]

  @@unique([storeId, slug])
  /// Phase 3.2: lets variants and reservations reference (storeId, id), so a row can never point at a product of another store.
  @@unique([storeId, id])
  @@index([storeId, status, position])
  @@index([storeId, categoryId])
  @@index([storeId, createdAt(sort: Desc), id])
}

model Media {
  id            String      @id @default(cuid())
  storeId       String
  uploadedById  String
  key           String      @unique
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  status        MediaStatus @default(READY)
  /// The smaller copies (`-w320/-w640/-w1024` objects, see shared/lib/storage/variants) exist in storage. False for images uploaded before they were made.
  variantsReady Boolean     @default(false)
  createdAt     DateTime    @default(now())

  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  products   Product[]
  galleryOf  ProductImage[]
  logoOf     Store[]        @relation("StoreLogo")

  @@unique([storeId, id])
  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

model Domain {
  id         String     @id @default(cuid())
  storeId    String
  kind       DomainKind
  host       String
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([kind, host])
  @@index([storeId])
}

/// Shared (multi-instance safe) fixed-window rate limit counters. Keys are hashed by the application.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Transactional outbox (ADR 0002 §2.8, phase 2.2). A domain event is inserted in the SAME transaction as the change it describes,
/// so it exists exactly when the change committed; the worker's relay publishes it to the queue and stamps `publishedAt`.
/// No foreign key to Store on purpose: an event must outlive its store (e.g. "store.deleted"), and the relay never joins.
/// CHECK constraints (type format, attempts >= 0) live in the migration SQL.
model OutboxEvent {
  id          String    @id @default(cuid())
  /// "<context>.<event>", e.g. "store.published".
  type        String    @db.VarChar(100)
  payload     Json
  storeId     String?
  occurredAt  DateTime  @default(now())
  /// Not published before this time: the relay's retry backoff after a failed publish.
  availableAt DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  /// Fixed, non-sensitive description of the last publish failure (never a URL or a payload).
  lastError   String?   @db.VarChar(200)

  /// The relay's scan: unpublished rows that are due, oldest first.
  @@index([publishedAt, availableAt])
}

/// Which slug each product has in each version. Immutable; written with the version.
model StoreVersionProduct {
  versionId String
  productId String
  slug      String

  version StoreVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, productId])
  @@unique([versionId, slug])
}

/// Every slug a product has ever been published under (append-only; productId deliberately has no foreign key so the
/// reservation outlives the product).
model PublishedSlug {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  slug      String
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, productId])
}

/// 30-day reservation of a released or orphaned subdomain. Independent of Store and Domain (no foreign keys), maintained by
/// triggers on Domain.
model SubdomainReservation {
  host            String   @id
  previousStoreId String
  cause           String
  releasedAt      DateTime @db.Timestamptz(6)
  reservedUntil   DateTime @db.Timestamptz(6)

  @@index([previousStoreId])
}

/// A staff member of a store (phase 2.3, D23-1). Created only by accepting an invitation (D23-2). Deleted with the store or the user.
model StoreMember {
  storeId   String
  userId    String
  role      StoreRole
  createdAt DateTime  @default(now())
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@index([userId])
}

/// A pending invitation (D23-2): the invitee must accept it. One per store and invitee; expires after 14 days.
model StoreInvitation {
  id            String    @id @default(cuid())
  storeId       String
  invitedUserId String
  role          StoreRole
  invitedById   String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedUser   User      @relation("invitee", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([storeId, invitedUserId])
  @@index([invitedUserId])
}

/// Audit log of sensitive store actions (D23-3). No foreign keys on purpose: an entry must outlive the actor and the store.
/// Kept one year, then deleted by db-cleanup. Plain identifiers and small facts only; never secrets or free text from requests.
model AuditEvent {
  id         String   @id @default(cuid())
  storeId    String?
  /// The real actor (a staff member acting for the owner is recorded as themself).
  actorId    String?
  action     String   @db.VarChar(60)
  targetType String?  @db.VarChar(40)
  targetId   String?  @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([createdAt])
}

/// A store secret (phase 2.4, D24-1), e.g. a payment gateway key: ONLY the envelope (wrapped data key + sealed value) is stored, bound to
/// (storeId, name) by AES-GCM associated data. The value is never returned by the API; `hint` is the last 4 characters for recognition
/// (only for values of 12+ characters). Deleted with the store.
model StoreSecret {
  storeId    String
  name       String   @db.VarChar(80)
  keyId      String   @db.VarChar(32)
  wrappedKey Bytes
  sealed     Bytes
  hint       String?  @db.VarChar(4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, name])
  @@index([keyId])
}

/// Platform operators (phase 3.1, D31-1). A platform account is an ordinary user with a row here; the role is read from the database on every
/// platform request (revoking takes effect at once). The first super admin is granted on the server (pnpm platform:admin); nothing grants
/// it over HTTP to oneself. Platform actions are written to AuditEvent with storeId = null.
enum PlatformRole {
  SUPER_ADMIN
}

model PlatformAdmin {
  userId      String       @id
  role        PlatformRole @default(SUPER_ADMIN)
  grantedAt   DateTime     @default(now())
  /// Null when granted by the server-side command.
  grantedById String?
  user        User         @relation("platformRole", fields: [userId], references: [id], onDelete: Cascade)
}

/// A shopper of ONE store (phase 3.1): unknown to every other store. `phone` is an Iranian mobile in the form +989xxxxxxxxx (CHECK).
/// Customers have their own session (separate cookie and token audience), never a merchant session. Deleted with the store.
model Customer {
  id              String            @id @default(cuid())
  storeId         String
  phone           String            @db.VarChar(16)
  name            String?           @db.VarChar(80)
  /// Bumped to end every session of this customer.
  authVersion     Int               @default(0)
  phoneVerifiedAt DateTime?
  /// Phase 3.3b: Argon2id hash for password sign-in (null = SMS code only). Dropped when the phone is first verified by SMS code.
  passwordHash    String?
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  carts           Cart[]
  addresses       CustomerAddress[]
  reviews         ProductReview[]

  @@unique([storeId, phone])
  /// Phase 3.3: lets carts and addresses reference (storeId, id), so they can never point at a customer of another store.
  @@unique([storeId, id])
  @@index([storeId, createdAt])
}

/// A one-time sign-in code for a customer (phase 3.1). Only an HMAC of the code is stored; valid 2 minutes, at most 5 attempts, consumed once.
/// Expired rows are deleted by the db-cleanup job.
model OtpChallenge {
  id         String    @id @default(cuid())
  storeId    String
  phone      String    @db.VarChar(16)
  codeHash   String    @db.VarChar(64)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, phone, createdAt])
  @@index([expiresAt])
}

/// Platform-wide settings managed by super admins (phase 3.1): one JSON value per group ("sms", "payment", "ai"), validated by the shared
/// Zod schemas on every write. Secret values (API keys, merchant ids) are NEVER here: they live in PlatformSecret.
model PlatformSetting {
  key         String   @id @db.VarChar(40)
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// A platform secret (phase 3.1), e.g. the Kavenegar API key: only the envelope (same AES-256-GCM scheme as StoreSecret, D24-1), bound to
/// "platform|name:<name>". Write-only over HTTP; read on the server by the component that needs it.
model PlatformSecret {
  name        String   @id @db.VarChar(80)
  keyId       String   @db.VarChar(32)
  wrappedKey  Bytes
  sealed      Bytes
  hint        String?  @db.VarChar(4)
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([keyId])
}

/// A purchasable variant of a product (phase 3.2, D32-1): one combination of up to 3 options (e.g. colour = red, size = M) with its own
/// price and stock. When a product has variants, Product.price is the LOWEST variant price and Product.stockQuantity the SUM of their stock
/// (kept in the same transaction by the inventory module), so listings and the storefront keep working unchanged.
model ProductVariant {
  id            String   @id @default(cuid())
  storeId       String
  productId     String
  /// [{name, value}] in the option order of the product (1..3 entries; validated by the application).
  options       Json
  /// Canonical JSON of the options ([["name","value"],...]): one variant per combination.
  optionsKey    String   @db.VarChar(500)
  sku           String?  @db.VarChar(64)
  price         Int
  stockQuantity Int      @default(0)
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product      Product            @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  reservations StockReservation[]
  priceLinks   PriceLink[]
  cartItems    CartItem[]

  @@unique([productId, optionsKey])
  @@unique([storeId, id])
  /// Phase 3.3: lets a cart line reference (storeId, productId, id), so its variant always belongs to its product.
  @@unique([storeId, productId, id])
  @@index([storeId, productId, position])
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

/// Stock held for a checkout (phase 3.2): the stock is decremented when the reservation is made; an ACTIVE reservation that expires is
/// released (stock given back) by the db-cleanup job; CONSUMED = turned into an order (3.4). `ref` names the cart or order that holds it.
model StockReservation {
  id        String            @id @default(cuid())
  storeId   String
  productId String
  variantId String?
  quantity  Int
  ref       String            @db.VarChar(64)
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  product Product         @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([storeId, ref])
  @@index([status, expiresAt])
}

enum RateCode {
  USD
  GOLD18
}

enum RateStatus {
  APPLIED
  PENDING
  REJECTED
}

/// A dollar or 18k-gold rate in toman (phase 3.2b, D32b-1). Append-only history: the current rate of a code is its latest APPLIED row.
/// PENDING = a jump above the configured threshold waiting for a super admin; REJECTED = refused by one (or implausible).
model ExchangeRate {
  id          String     @id @default(cuid())
  code        RateCode
  rateToman   Int
  /// "manual" or the provider's name.
  source      String     @db.VarChar(20)
  observedAt  DateTime
  status      RateStatus
  /// The super admin who entered, confirmed or rejected it (null for an automatic apply).
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([code, status, createdAt])
  @@index([status, createdAt])
}

enum PriceLinkKind {
  USD
  GOLD
}

enum PriceLinkStatus {
  OK
  OUT_OF_RANGE
}

/// A product's (or one variant's) price that follows the dollar or gold (phase 3.2b). `target` is the variant id, or "-" for the product
/// itself, so (productId, target) is unique for both. The price columns of Product / ProductVariant hold the last computed price.
model PriceLink {
  id             String          @id @default(cuid())
  storeId        String
  productId      String
  variantId      String?
  target         String          @db.VarChar(64)
  kind           PriceLinkKind
  usdCents       Int?
  weightMg       Int?
  wageBp         Int             @default(0)
  profitBp       Int             @default(0)
  taxBp          Int             @default(0)
  stoneToman     Int             @default(0)
  roundingToman  Int             @default(1000)
  status         PriceLinkStatus @default(OK)
  lastPriceToman Int?
  lastRateAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  product Product         @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, target])
  @@index([storeId])
}

/// The PUBLIC projection of linked prices (phase 3.2b): written only by repricing, read by the published storefront to show the current
/// price of a linked product on top of its published snapshot. Not a draft table: it never holds anything the merchant has not linked.
model LivePrice {
  storeId    String
  productId  String
  /// Variant id, or "-" for the product's own (or lowest variant) price.
  target     String   @db.VarChar(64)
  priceToman Int
  updatedAt  DateTime

  product Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)

  @@id([productId, target])
  @@index([storeId])
}

// ---------- Phase 3.3 (D33-1): cart, shipping methods, addresses ----------

enum ShippingKind {
  FLAT
  WEIGHT
  PICKUP
}

/// A store's shipping method. Operational setting, not draft content: a change applies to checkout at once (no publish).
/// Read by the public checkout (allowlisted with LivePrice). Province codes are checked for shape here and for membership by the application.
model ShippingMethod {
  id               String       @id @default(cuid())
  storeId          String
  name             String       @db.VarChar(60)
  kind             ShippingKind
  enabled          Boolean      @default(true)
  description      String       @default("") @db.VarChar(200)
  price            Int          @default(0)
  perKg            Int          @default(0)
  defaultItemGrams Int          @default(500)
  /// [] = all of Iran.
  provinces        String[]     @default([])
  /// [{province, price}] (validated by the application; CHECK: a JSON array of at most 31 elements).
  provincePrices   Json         @default("[]")
  freeAbove        Int?
  codEnabled       Boolean      @default(false)
  codProvinces     String[]     @default([])
  codFee           Int          @default(0)
  position         Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, position])
}

/// A shopper's cart in one store. A guest holds a random token in a cookie; only its SHA-256 is stored. A signed-in customer's cart
/// carries the customer id. Deleted by db-cleanup after CART_TTL_DAYS without a change.
model Cart {
  id         String   @id @default(cuid())
  storeId    String
  tokenHash  String   @db.Char(64)
  customerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [storeId, customerId], references: [storeId, id], onDelete: Cascade)
  items    CartItem[]

  @@unique([tokenHash])
  @@unique([storeId, id])
  /// At most one cart per customer: a partial UNIQUE index in the migration ("Cart_storeId_customerId_one", WHERE "customerId" IS NOT NULL).
  @@index([storeId, customerId])
  @@index([updatedAt])
}

/// One line: a product, or one variant of it. No price is stored: checkout always reads the current one.
model CartItem {
  id        String   @id @default(cuid())
  storeId   String
  cartId    String
  productId String
  variantId String?
  /// "<productId>|<variantId or ->": one line per product/variant (a NULL variant would not be unique in a plain index).
  lineKey   String   @db.VarChar(130)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [storeId, cartId], references: [storeId, id], onDelete: Cascade)
  product Product         @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  /// (storeId, productId, variantId): the variant must belong to THIS line's product (review 3.3).
  variant ProductVariant? @relation(fields: [storeId, productId, variantId], references: [storeId, productId, id], onDelete: Cascade)

  @@unique([cartId, lineKey])
  @@index([storeId, productId])
}

/// A signed-in customer's saved delivery address (guests type theirs at checkout).
model CustomerAddress {
  id            String   @id @default(cuid())
  storeId       String
  customerId    String
  recipientName String   @db.VarChar(80)
  phone         String   @db.VarChar(16)
  province      String   @db.VarChar(32)
  city          String   @db.VarChar(40)
  line          String   @db.VarChar(250)
  postalCode    String   @db.Char(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [storeId, customerId], references: [storeId, id], onDelete: Cascade)

  @@unique([storeId, id])
  @@index([storeId, customerId, createdAt])
}

// ---------- Phase 3.4 (D34-1): orders and invoices ----------

enum OrderStatus {
  AWAITING_PAYMENT
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum OrderPaymentMethod {
  COD
  ONLINE
  /// D35b-1: card-to-card, confirmed by the merchant from the shopper's receipt.
  CARD_TRANSFER
}

enum PaymentStatus {
  CREATED
  VERIFYING
  PAID
  FAILED
  EXPIRED
  /// Verified money on an order that was no longer payable (paid by another attempt, or a lost verify answer): the merchant must refund it.
  REFUND_REQUIRED
}

enum OrderActor {
  CUSTOMER
  MERCHANT
  SYSTEM
}

/// Per-store sequences. The row is locked and incremented in the order's own transaction, so numbers are gap-free (a rollback
/// rolls the counter back too) and two orders never share one.
model StoreCounter {
  storeId         String @id
  lastOrderNumber Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

/// An order: a SNAPSHOT of what was bought, for how much, delivered where (never re-read from the catalog). Money in toman as BigInt
/// (a cart can exceed a 32-bit integer). `customerId` has no foreign key on purpose: the order outlives any change to the customer.
model Order {
  id               String             @id @default(cuid())
  storeId          String
  /// Gap-free per store; also the invoice number.
  number           Int
  status           OrderStatus        @default(PLACED)
  customerId       String?
  /// Phase 3.3b: placed as a guest and attached to the store's customer with the same phone; shown to that customer only once the
  /// phone is verified by SMS code.
  linkedByPhone    Boolean            @default(false)
  /// Client-made key of the checkout attempt: the same key returns the same order (no double orders).
  requestKey       String             @db.VarChar(64)
  /// SHA-256 of the access token handed to the shopper once (a guest follows and cancels the order with it).
  accessTokenHash  String             @unique @db.Char(64)
  recipientName    String             @db.VarChar(80)
  phone            String             @db.VarChar(16)
  province         String             @db.VarChar(32)
  city             String             @db.VarChar(40)
  addressLine      String             @db.VarChar(250)
  postalCode       String             @db.Char(10)
  shippingMethodId String?
  shippingName     String             @db.VarChar(60)
  shippingKind     ShippingKind
  shippingCost     BigInt
  paymentMethod    OrderPaymentMethod
  /// Phase 5.1: the discount code used (snapshot) and the whole discount in toman (items + shipping); total already reflects it.
  discountCode     String?            @db.VarChar(32)
  discountAmount   BigInt             @default(0)
  /// D35c-1: the online gateway the shopper chose (ONLINE orders only): ZARINPAL | AQAYEPARDAKHT.
  paymentGateway   String?            @db.VarChar(20)
  /// Phase 3.5: an online order not paid by then expires (stock back). Null for cash on delivery.
  paymentDeadline  DateTime?
  codFee           BigInt             @default(0)
  subtotal         BigInt
  total            BigInt
  itemCount        Int
  /// The carrier's tracking code, entered by the merchant when shipping (SHIPPED or DELIVERED orders only; CHECK in the migration).
  trackingCode     String?            @db.VarChar(40)
  note             String             @default("") @db.VarChar(500)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items      OrderItem[]
  events     OrderEvent[]
  payments   Payment[]
  receipts   TransferReceipt[]
  redemption DiscountRedemption?

  @@unique([storeId, number])
  @@unique([storeId, requestKey])
  @@unique([storeId, id])
  @@index([storeId, createdAt(sort: Desc), id])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([storeId, customerId, createdAt(sort: Desc)])
}

/// One bought line as it was at checkout (name, option text, unit price). The product may change or disappear later.
model OrderItem {
  id           String  @id @default(cuid())
  storeId      String
  orderId      String
  productId    String
  variantId    String?
  name         String  @db.VarChar(120)
  variantLabel String  @default("") @db.VarChar(300)
  unitPrice    Int
  quantity     Int
  lineTotal    BigInt
  weightGrams  Int?
  position     Int

  order Order @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId, orderId, position])
}

/// Append-only history: every status an order has had, who moved it and when.
model OrderEvent {
  id         String       @id @default(cuid())
  storeId    String
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      OrderActor
  /// The merchant user (MERCHANT) or the customer id (CUSTOMER, when signed in); null for guests and the system.
  actorId    String?
  note       String       @default("") @db.VarChar(500)
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId, orderId, createdAt])
}

// ---------- Phase 3.5 (D35-1): online payment (Zarinpal) ----------

/// One attempt to pay an order at the gateway. Verified ONLY by the server (auto_verify=false): an attempt the server never verified is
/// refunded to the buyer by Zarinpal. The authority is unique per gateway session; amounts are rial as sent to the gateway.
model Payment {
  id                  String        @id @default(cuid())
  storeId             String
  orderId             String
  provider            String        @db.VarChar(20)
  sandbox             Boolean
  authority           String        @unique @db.VarChar(40)
  amountRial          BigInt
  status              PaymentStatus @default(CREATED)
  /// When VERIFYING began (a verification interrupted for long is resumed by the reconciliation job).
  claimedAt           DateTime?
  /// Set when a verify call was first SENT (its answer may be lost): from then on the attempt is never closed without a definite answer.
  verifySentAt        DateTime?
  /// SHA-256 of the merchant id the session was opened with: never verified with a different one (review 3.5).
  merchantFingerprint String        @db.VarChar(64)
  /// SHA-256 of the return key held by the paying browser (HttpOnly cookie): only that browser gets the order link back.
  returnKeyHash       String        @db.VarChar(64)
  /// Reconciler back-off: when the attempt is checked next, and how often it was checked.
  nextCheckAt         DateTime      @default(now())
  checks              Int           @default(0)
  refId               String?       @db.VarChar(40)
  cardPan             String?       @db.VarChar(32)
  fee                 BigInt?
  /// Last gateway code seen (100, 101, -51, ...), for support; never a message from the provider.
  lastCode            Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  verifiedAt          DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId, orderId, createdAt])
  @@index([status, nextCheckAt])
}

/// D35b-1: a bank card of the store, shown to shoppers who pay card-to-card (the merchant's own card: not a secret).
model StoreBankCard {
  id         String   @id @default(cuid())
  storeId    String
  cardNumber String   @db.VarChar(16)
  holderName String   @db.VarChar(60)
  bankName   String   @db.VarChar(40)
  position   Int
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, cardNumber])
  @@index([storeId, position])
}

enum ReceiptStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/// D35b-1: a card-to-card receipt sent by the shopper. The image is re-encoded (no EXIF/GPS) and kept here, never in the public bucket:
/// only the store's staff (orders.view) can fetch it, through the API.
model TransferReceipt {
  id             String        @id @default(cuid())
  storeId        String
  orderId        String
  status         ReceiptStatus @default(SUBMITTED)
  trackingCode   String        @db.VarChar(30)
  payerCardLast4 String        @db.Char(4)
  image          Bytes
  imageMime      String        @db.VarChar(20)
  imageWidth     Int
  imageHeight    Int
  reviewNote     String        @default("") @db.VarChar(300)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId, orderId, createdAt])
  @@index([storeId, status, createdAt])
}

/// Phase 3.6 (D36-1): a store's order-SMS choice. No row = order SMS on, no merchant phone (merchant SMS not sent).
model StoreSmsSetting {
  storeId       String   @id
  enabled       Boolean  @default(true)
  /// The merchant's mobile (E.164) for new-order and receipt SMS; null = none.
  merchantPhone String?  @db.VarChar(13)
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

/// Phase 3.6 (D36-1): one order SMS (or the decision not to send it), keyed by the domain event and the kind: delivery of events is
/// at-least-once, so a second delivery finds the row and sends nothing. Also the store's monthly count. No phone number, no message text.
model SmsMessage {
  id            String   @id @default(cuid())
  storeId       String
  eventId       String   @db.VarChar(40)
  kind          String   @db.VarChar(40)
  orderId       String?
  /// SHA-256 of the recipient's phone (never the number): the platform-wide daily limit per phone (review 3.6).
  recipientHash String?  @db.VarChar(64)
  /// PENDING (claimed, being sent), SENT, FAILED (retried by the queue), SKIPPED (off, capped, no phone, no template).
  status        String   @db.VarChar(10)
  reason        String?  @db.VarChar(30)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind])
  @@index([storeId, createdAt])
  @@index([recipientHash, createdAt])
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum DiscountScope {
  ALL
  PRODUCTS
  CATEGORIES
}

/// Phase 5.1 (D51-1): a store's discount code. Codes are stored upper-case and unique per store.
model Discount {
  id               String        @id @default(cuid())
  storeId          String
  code             String        @db.VarChar(32)
  title            String        @default("") @db.VarChar(80)
  type             DiscountType
  /// PERCENT: 1..100; FIXED: toman; FREE_SHIPPING: 0.
  value            BigInt
  maxDiscount      BigInt?
  minOrder         BigInt?
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  firstOrderOnly   Boolean       @default(false)
  scope            DiscountScope @default(ALL)
  scopeIds         String[]      @default([])
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  redemptions DiscountRedemption[]

  @@unique([storeId, code])
  @@unique([storeId, id])
  @@index([storeId, createdAt])
}

/// Phase 5.1: one use of a discount by one order, written in the order's own transaction under the discount's row lock (usage limits are
/// race-free); released (not deleted) when the order is cancelled or expires, so the use comes back.
model DiscountRedemption {
  id         String   @id @default(cuid())
  storeId    String
  discountId String
  orderId    String
  phone      String   @db.VarChar(13)
  customerId String?
  amount     BigInt
  released   Boolean  @default(false)
  createdAt  DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [storeId, discountId], references: [storeId, id], onDelete: Cascade)
  order    Order    @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Cascade)

  @@unique([storeId, orderId])
  @@index([discountId, released])
  @@index([storeId, phone])
}

/// ADR 0003 (G2): why a store is suspended by the platform.
enum SuspensionReason {
  FRAUD
  PROHIBITED_GOODS
  PHISHING_OR_IMPERSONATION
  LEGAL_ORDER
  PAYMENT_PROVIDER_REQUEST
  CUSTOMER_COMPLAINTS
  SECURITY_INCIDENT
  OTHER
}

/// ADR 0003 (G2): the history of platform suspensions of a store (platform data: never shown to store staff except `publicMessage` of the
/// open one). At most ONE open row per store (partial unique index); `Store.suspendedAt` mirrors the open row, written in the same
/// transaction. No foreign key on purpose: the history outlives the store (evidence), like OutboxEvent. CHECKs in the migration SQL.
model StoreSuspension {
  id                    String           @id @default(cuid())
  storeId               String
  reason                SuspensionReason
  /// Shown to the store's owner and staff in the dashboard. Never to shoppers.
  publicMessage         String           @db.VarChar(300)
  /// Platform admins only. Never in AuditEvent rows of the store, never in a merchant or shopper answer.
  internalNote          String           @db.VarChar(2000)
  /// The merchant's publishing status when the suspension started (for the record; restoring never changes it).
  merchantStatusAtStart StoreStatus
  suspendedById         String?
  suspendedAt           DateTime         @default(now())
  liftedById            String?
  liftedAt              DateTime?
  liftNote              String?          @db.VarChar(2000)

  @@index([storeId, suspendedAt])
}

/// Store trend charts: page views and visitors per Tehran calendar day (MVP analytics). Counters only; nothing identifies a shopper.
model StoreDailyStat {
  storeId  String
  /// The Tehran calendar day.
  day      DateTime @db.Date
  views    Int      @default(0)
  visitors Int      @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day])
}

/// Counts a visitor once per day: a SHA-256 of (secret, day, store, address, browser) that cannot be reversed or linked across days.
/// Rows older than two days are deleted by the db-cleanup job; the daily counters above are what is kept.
model StoreDailyVisitor {
  storeId String
  day     DateTime @db.Date
  hash    String   @db.Char(64)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day, hash])
  @@index([day])
}

/// The extra images of a product's gallery. The FIRST image is Product.imageId (so cards, snapshots and every existing reader are unchanged);
/// these are images 2 to 6, at positions 1 to 5 (CHECK in the migration). Composite keys keep a row inside its own store; a media row that is
/// still used here cannot be deleted (NO ACTION), exactly like Product.image.
model ProductImage {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  mediaId   String
  position  Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  media   Media   @relation(fields: [storeId, mediaId], references: [storeId, id], onDelete: NoAction)

  @@unique([productId, position])
  @@unique([productId, mediaId])
  @@index([storeId, mediaId])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketMessageFrom {
  SELLER
  STAFF
}

/// A support request from a store's owner or manager to the platform staff. Deleted with the store.
model SupportTicket {
  id            String       @id @default(cuid())
  storeId       String
  /// The user who opened it (no foreign key: kept even if the account is later removed).
  createdById   String
  subject       String       @db.VarChar(120)
  status        TicketStatus @default(OPEN)
  messageCount  Int          @default(1)
  lastMessageAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  store    Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([storeId, lastMessageAt])
  @@index([status, lastMessageAt])
}

model SupportTicketMessage {
  id        String            @id @default(cuid())
  ticketId  String
  from      TicketMessageFrom
  /// The merchant's user id, or the staff member's (never shown to the merchant).
  authorId  String
  body      String            @db.VarChar(4000)
  createdAt DateTime          @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A customer's review of a product: shown to the public only once the merchant approves it. One per customer and product.
model ProductReview {
  id         String       @id @default(cuid())
  storeId    String
  productId  String
  customerId String
  /// The customer's name at the time (or "خریدار"); never the phone number.
  authorName String       @db.VarChar(60)
  rating     Int
  body       String       @db.VarChar(1000)
  status     ReviewStatus @default(PENDING)
  /// The merchant's public answer.
  reply      String?      @db.VarChar(1000)
  repliedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product  Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  customer Customer @relation(fields: [storeId, customerId], references: [storeId, id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([storeId, status, createdAt])
  @@index([productId, status, createdAt])
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

/// A blog article of a store. PUBLISHED goes live with the next store publish (it is part of the published snapshot). Plain text only.
model BlogPost {
  id          String         @id @default(cuid())
  storeId     String
  title       String         @db.VarChar(120)
  /// Generated from the title when the post is created and never changed afterwards (links stay stable).
  slug        String         @db.VarChar(140)
  excerpt     String         @default("") @db.VarChar(300)
  body        String         @db.VarChar(10000)
  status      BlogPostStatus @default(DRAFT)
  /// When it was first marked PUBLISHED (kept when it is unpublished and published again).
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, status, publishedAt])
}

/// A subscription plan the platform sells (created by the super admin). Never deleted: `active = false` stops new purchases only.
model Plan {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(60)
  description  String   @default("") @db.VarChar(300)
  priceToman   Int
  durationDays Int
  /// What the plan allows while its period runs: products in the store, and staff (members plus pending invitations).
  maxProducts  Int      @default(500)
  maxStaff     Int      @default(20)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions StoreSubscription[]
  purchases     SubscriptionPurchase[]
}

/// The store's current subscription period (one row per store; each purchase moves it forward). Its plan's limits apply while it runs; without one the free limits apply.
model StoreSubscription {
  storeId   String   @id
  planId    String
  /// The plan's name when bought (the plan may be renamed later).
  planName  String   @db.VarChar(60)
  startsAt  DateTime
  endsAt    DateTime
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Restrict)
}

/// One recorded purchase of a plan: prices as they were then. Recorded by platform staff after they received the money.
model SubscriptionPurchase {
  id              String   @id @default(cuid())
  storeId         String
  planId          String
  planName        String   @db.VarChar(60)
  priceToman      Int
  discountToman   Int
  walletUsedToman Int
  cashToman       Int
  periodStart     DateTime
  periodEnd       DateTime
  note            String   @default("") @db.VarChar(200)
  recordedById    String
  /// The gateway payment this purchase settled (null = recorded by platform staff or paid entirely from the wallet).
  paymentId       String?  @unique
  createdAt       DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
}

enum PlatformPaymentPurpose {
  PURCHASE
  TOPUP
}

enum PlatformPaymentStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
  LATE_CREDITED
}

/// A payment a store makes to the PLATFORM through the gateway: a plan (possibly with wallet credit held for it) or a wallet top-up.
/// The wallet part of a plan payment is taken when the payment opens (ledger kind PURCHASE) and given back (REFUND) if it never succeeds.
/// At most ONE open (CREATED) row per store (partial unique index "PlatformPayment_one_open_per_store" in the migration).
/// Amounts are toman; the gateway is asked in rial (x10). Money is verified server side before anything is granted.
model PlatformPayment {
  id            String                 @id @default(cuid())
  storeId       String
  userId        String
  purpose       PlatformPaymentPurpose
  planId        String?
  /// The plan as it was when the payment opened: the subscription is granted from THIS, whatever changes later.
  planName      String?                @db.VarChar(60)
  durationDays  Int?
  priceToman    Int                    @default(0)
  discountToman Int                    @default(0)
  /// Wallet credit taken when the payment opened (plan payments only).
  heldToman     Int                    @default(0)
  /// What the gateway charges.
  amountToman   Int
  status        PlatformPaymentStatus  @default(CREATED)
  sandbox       Boolean
  authority     String?                @unique @db.VarChar(40)
  refId         String?                @db.VarChar(40)
  cardPan       String?                @db.VarChar(32)
  /// Reconciler back-off.
  nextCheckAt   DateTime               @default(now())
  checks        Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  paidAt        DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([status, nextCheckAt])
}

/// The store's gift-credit balance. The row is the one lock that serialises every credit and debit of the store; the balance never goes below 0 (CHECK).
model StoreWallet {
  storeId      String   @id
  balanceToman Int      @default(0)
  updatedAt    DateTime @updatedAt

  store   Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entries WalletEntry[]
}

enum WalletEntryKind {
  REFERRAL_REWARD
  PURCHASE
  ADMIN_ADJUST
  TOPUP
  REFUND
}

/// An append-only ledger line of a wallet: a signed amount and the balance after it.
model WalletEntry {
  id           String          @id @default(cuid())
  storeId      String
  amountToman  Int
  balanceAfter Int
  kind         WalletEntryKind
  note         String          @default("") @db.VarChar(200)
  /// The purchase or referral the line belongs to.
  refId        String?
  createdAt    DateTime        @default(now())

  wallet StoreWallet @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@index([storeId, createdAt])
}

/// The store's own referral code (made on first use).
model StoreReferralCode {
  storeId   String   @id
  code      String   @unique @db.VarChar(8)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

enum ReferralStatus {
  PENDING
  REWARDED
}

/// A store invited by another store's code. One per invited store. REWARDED once its first paid purchase gave the inviter credit.
model Referral {
  id              String         @id @default(cuid())
  referrerStoreId String
  referredStoreId String         @unique
  status          ReferralStatus @default(PENDING)
  rewardToman     Int            @default(0)
  rewardedAt      DateTime?
  purchaseId      String?
  createdAt       DateTime       @default(now())

  referrer Store @relation("Referrer", fields: [referrerStoreId], references: [id], onDelete: Cascade)
  referred Store @relation("Referred", fields: [referredStoreId], references: [id], onDelete: Cascade)

  @@index([referrerStoreId, createdAt])
}
