# Copy to apps/api/.env (git-ignored). `pnpm api:dev` loads it; Prisma commands (db:deploy, db:seed, ...) read DATABASE_URL from it too.
NODE_ENV=development
DATABASE_URL=postgresql://storebuilder:storebuilder@localhost:5432/storebuilder

# S3-compatible storage (the MinIO of `pnpm db:up`). Without these the API starts, but uploads and /api/ready report storage as unavailable.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=store-builder-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/store-builder-media

# Optional in development (defaults: localhost:3000 / http / a fixed development-only secret):
# APP_ROOT_DOMAIN=localhost:3000
# APP_PROTOCOL=http
# AUTH_SECRET=
# API_PORT=4000

# Development only: shopper sign-in codes (SMS / OTP) are written to the API log instead of being sent, so SMS sign-in can be tried
# without a Kavenegar account. The API refuses to start with this outside NODE_ENV=development/test.
# CUSTOMER_OTP_DEV_LOG=true

# Development only (phase 3.5): online payments go to a LOCAL fake Zarinpal instead of the real one (loopback http address only).
# The API refuses to start with this outside NODE_ENV=development/test.
# ZARINPAL_DEV_BASE_URL=http://127.0.0.1:4545
# D35c-1, same rules: a local fake Aghaye Pardakht.
# AQAYEPARDAKHT_DEV_BASE_URL=http://127.0.0.1:4546

# Development only (phase 3.6): the WORKER writes order SMS (kind, template, masked phone, order number) to its log instead of sending.
# ORDER_SMS_DEV_LOG=true
