# Copy to apps/api/.env (git-ignored). `pnpm api:dev` loads it; Prisma commands (db:deploy, db:seed, ...) read DATABASE_URL from it too.
NODE_ENV=development
DATABASE_URL=postgresql://storebuilder:storebuilder@localhost:5432/storebuilder

# S3-compatible storage (the MinIO of `pnpm db:up`). Without these the API starts, but uploads and /api/ready report storage as unavailable.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=store-builder-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/store-builder-media

# Optional in development (defaults: localhost:3000 / http / a fixed development-only secret):
# APP_ROOT_DOMAIN=localhost:3000
# APP_PROTOCOL=http
# AUTH_SECRET=
# API_PORT=4000
