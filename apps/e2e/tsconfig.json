{
  "compilerOptions": {
    "target": "ES2022", "module": "esnext", "moduleResolution": "bundler", "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true, "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
