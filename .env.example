# Copy to .env.local and adjust.

# Platform root domain (panel lives here; stores live at <subdomain>.<root>).
# Dev: stores are reachable at http://<name>.localhost:3000
APP_ROOT_DOMAIN=localhost:3000
APP_PROTOCOL=http

# PostgreSQL (docker compose)
DATABASE_URL=postgresql://storebuilder:storebuilder@localhost:5432/storebuilder

# S3-compatible storage (MinIO in dev). Credentials have WRITE access and are server-only; the browser only receives
# public, read-only object URLs under S3_PUBLIC_BASE_URL. The bucket must allow anonymous s3:GetObject ONLY
# (no ListBucket, no Put/Delete). Anyone who has an image URL can read that image: never store private files here.
# S3_PUBLIC_BASE_URL is the only place a host/bucket appears; stored data holds relative keys, so it can change later.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=store-builder-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/store-builder-media

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
# "postgres" (shared, default) or "memory" (single process, dev/test only)
RATE_LIMIT_BACKEND=postgres

# Client IP for rate limiting. Forwarding headers are NOT trusted unless this is "true".
# Only enable behind a reverse proxy that appends/overwrites X-Forwarded-For (see docs/deployment.md).
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1
