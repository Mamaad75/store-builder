{
  "name": "@store-builder/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free code shared by apps/api and apps/web: template definitions, storefront data schemas, text/money helpers (ADR 0001)",
  "exports": {
    "./*": { "types": "./dist/*.d.ts", "default": "./dist/*.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": { "zod": "^4.6.7" },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
