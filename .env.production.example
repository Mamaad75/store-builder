# Production settings for docker-compose.prod.yml. Copy to .env.production on the SERVER (never commit it), mode 600.
# Generate secrets on the server:  openssl rand -base64 32   (AUTH_SECRET: signs sessions, used by the API only)   openssl rand -hex 24   (POSTGRES_PASSWORD)
# Use only URL-safe characters in POSTGRES_PASSWORD (hex is ideal): it is embedded in DATABASE_URL.

# Bare host name of the platform, e.g. example.com (stores live at <name>.example.com)
APP_ROOT_DOMAIN=
APP_PROTOCOL=https

POSTGRES_USER=storebuilder
POSTGRES_DB=storebuilder
POSTGRES_PASSWORD=

AUTH_SECRET=

# External S3-compatible object storage (decision D13-2). The bucket must allow anonymous read of objects ONLY (docs/media.md).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Mail (decision DM2-1): "smtp" sends real mail (password reset) through any SMTP provider over mandatory TLS; "none" sends nothing.
# "log" and "file" make the server refuse to start in production. With "smtp", missing SMTP_HOST / MAIL_FROM (or half a
# user/password pair) also refuses start-up. Port 587 = STARTTLS (required), 465 = implicit TLS.
MAIL_TRANSPORT=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g.  Store Builder <noreply@example.com>   (the domain needs SPF, DKIM and DMARC records)
MAIL_FROM=

# Alerts through a Bale bot (decision D14-3): create the bot with @botfather in Bale, put its token here (never in chat or git) and the
# id of the chat/group that receives alerts. Prove it with:  $DC run --rm --no-deps scheduler pnpm alert:test
BALE_BOT_TOKEN=
BALE_CHAT_ID=

# Caddy / TLS (filled in phase 14 once the DNS provider is chosen).
# e.g. github.com/caddy-dns/<provider>
CADDY_DNS_MODULE=
DNS_API_TOKEN=
CADDY_TLS_DIR=./docker/caddy/tls.d
