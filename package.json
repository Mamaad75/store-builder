{
  "name": "store-builder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "Multi-tenant SaaS storefront website builder (MVP): pnpm workspace (ADR 0001)",
  "scripts": {
    "dev": "pnpm shared:build && pnpm --filter @store-builder/web dev",
    "build": "pnpm shared:build && pnpm --filter @store-builder/web build",
    "start": "pnpm --filter @store-builder/web start",
    "lint": "pnpm shared:build && pnpm --filter @store-builder/shared lint && pnpm --filter @store-builder/api lint && pnpm --filter @store-builder/web lint",
    "typecheck": "pnpm shared:build && pnpm --filter @store-builder/shared typecheck && pnpm --filter @store-builder/api typecheck && pnpm --filter @store-builder/web typecheck",
    "test": "pnpm shared:build && pnpm --filter @store-builder/shared test && pnpm --filter @store-builder/api test && pnpm --filter @store-builder/web test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:db",
    "api:dev": "pnpm --filter @store-builder/api dev",
    "api:build": "pnpm --filter @store-builder/api build",
    "api:start": "pnpm --filter @store-builder/api start",
    "api:lint": "pnpm --filter @store-builder/api lint",
    "api:typecheck": "pnpm --filter @store-builder/api typecheck",
    "api:test": "pnpm --filter @store-builder/api test",
    "api:test:db": "pnpm --filter @store-builder/api test:db",
    "db:generate": "pnpm --filter @store-builder/api db:generate",
    "db:migrate": "pnpm --filter @store-builder/api db:migrate",
    "db:deploy": "pnpm --filter @store-builder/api db:deploy",
    "db:seed": "pnpm --filter @store-builder/api db:seed",
    "db:reset": "pnpm --filter @store-builder/api db:reset",
    "db:studio": "pnpm --filter @store-builder/api db:studio",
    "test:db": "pnpm --filter @store-builder/api test:db",
    "test:storage": "pnpm --filter @store-builder/api test:storage",
    "test:mail": "pnpm --filter @store-builder/web test:mail",
    "db:cleanup": "pnpm --filter @store-builder/api db:cleanup",
    "media:cleanup": "pnpm --filter @store-builder/api media:cleanup",
    "publish:stats": "pnpm --filter @store-builder/api publish:stats",
    "test:e2e": "pnpm shared:build && pnpm --filter @store-builder/e2e test",
    "worker": "pnpm --filter @store-builder/api worker",
    "test:queue": "pnpm --filter @store-builder/api test:queue",
    "worker:health": "pnpm --filter @store-builder/api worker:health",
    "secrets:rotate": "pnpm --filter @store-builder/api secrets:rotate",
    "alert:test": "pnpm --filter @store-builder/api alert:test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "shared:build": "pnpm --filter @store-builder/shared build",
    "shared:dev": "pnpm --filter @store-builder/shared dev",
    "shared:test": "pnpm --filter @store-builder/shared test",
    "test:smoke": "pnpm --filter @store-builder/e2e smoke"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    },
    "packageExtensions": {
      "eslint-config-next": {
        "peerDependencies": {
          "next": "*"
        }
      }
    },
    "overrides": {
      "effect": "3.22.4"
    }
  }
}
