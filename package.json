{
  "name": "store-builder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "Multi-tenant SaaS storefront website builder (MVP): pnpm workspace (ADR 0001)",
  "scripts": {
    "dev": "pnpm --filter @store-builder/web dev",
    "build": "pnpm --filter @store-builder/web build",
    "start": "pnpm --filter @store-builder/web start",
    "lint": "pnpm --filter @store-builder/web lint",
    "typecheck": "pnpm --filter @store-builder/web typecheck",
    "test": "pnpm --filter @store-builder/web test",
    "check": "pnpm --filter @store-builder/web check",
    "api:dev": "pnpm --filter @store-builder/api dev",
    "api:build": "pnpm --filter @store-builder/api build",
    "api:start": "pnpm --filter @store-builder/api start",
    "api:lint": "pnpm --filter @store-builder/api lint",
    "api:typecheck": "pnpm --filter @store-builder/api typecheck",
    "api:test": "pnpm --filter @store-builder/api test",
    "api:test:db": "pnpm --filter @store-builder/api test:db",
    "db:generate": "pnpm --filter @store-builder/web db:generate",
    "db:migrate": "pnpm --filter @store-builder/web db:migrate",
    "db:deploy": "pnpm --filter @store-builder/web db:deploy",
    "db:seed": "pnpm --filter @store-builder/web db:seed",
    "db:reset": "pnpm --filter @store-builder/web db:reset",
    "db:studio": "pnpm --filter @store-builder/web db:studio",
    "test:db": "pnpm --filter @store-builder/web test:db",
    "test:storage": "pnpm --filter @store-builder/web test:storage",
    "test:mail": "pnpm --filter @store-builder/web test:mail",
    "db:cleanup": "pnpm --filter @store-builder/web db:cleanup",
    "media:cleanup": "pnpm --filter @store-builder/web media:cleanup",
    "publish:stats": "pnpm --filter @store-builder/web publish:stats",
    "test:e2e": "pnpm --filter @store-builder/web test:e2e",
    "scheduler": "pnpm --filter @store-builder/web scheduler",
    "scheduler:health": "pnpm --filter @store-builder/web scheduler:health",
    "alert:test": "pnpm --filter @store-builder/web alert:test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    },
    "packageExtensions": {
      "eslint-config-next": {
        "peerDependencies": {
          "next": "*"
        }
      }
    }
  }
}
